{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@metro/*": ["src/metro/*"],
      "@patcher/*": ["src/patcher/*"],
      "@storage/*": ["src/storage/*"],
      "@ui/*": ["src/ui/*"],
      "@plugins/*": ["src/plugins/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*"]
}
